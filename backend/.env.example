PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bughunter

# Include Redis password when REDIS_PASSWORD is set (must match docker-compose REDIS_PASSWORD):
# REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32  (minimum 32 chars required)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars = 32 bytes)
CREDENTIALS_ENCRYPTION_KEY=change-me-in-production

# Must match AGENT_API_SECRET in agent/.env
AGENT_API_SECRET=change-me-in-production

# Redis auth password — must match REDIS_PASSWORD in docker-compose
# REDIS_PASSWORD=change-me-in-production
