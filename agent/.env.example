# ── LLM Provider Configuration ───────────────────────────────────────────
# Set LLM_PROVIDER to one of: anthropic, openai, google, groq, mistral, ollama, claude_cli
# LLM_PROVIDER=anthropic
LLM_PROVIDER=claude_cli
# Optional: override the default model for your chosen provider
# LLM_MODEL=claude-3-5-sonnet-20241022

# Anthropic (default)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Google Gemini
# GOOGLE_API_KEY=your-google-api-key

# Groq (fast + free tier available)
# GROQ_API_KEY=your-groq-api-key

# Mistral
# MISTRAL_API_KEY=your-mistral-api-key

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Claude Code CLI (no API key needed — uses `claude` CLI with SSO/browser auth)
# Requires Claude Code installed and authenticated: https://claude.ai/code
# LLM_PROVIDER=claude_cli
# LLM_MODEL=claude-sonnet-4-6
# CLAUDE_CLI_TIMEOUT=300

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bughunter
# Include Redis password when REDIS_PASSWORD is set:
# REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_URL=redis://localhost:6379

# ── Backend API callback ──────────────────────────────────────────────────
# URL of the Node.js backend so the agent can report run status via HTTP
BACKEND_URL=http://localhost:5000
# Shared secret for agent → backend PATCH /api/runs/:id calls (generate with: openssl rand -hex 16)
AGENT_API_SECRET=change-me-in-production

# ── Agent tuning ─────────────────────────────────────────────────────────
# Max pages to explore per run (default: 5)
# AGENT_MAX_PAGES=5

# ── Storage (for screenshots, optional) ──────────────────────────────────
# Leave these unset to store screenshots locally only
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# S3_BUCKET=bughunter-screenshots
# S3_REGION=us-east-1
