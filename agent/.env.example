# ── LLM Provider Configuration ───────────────────────────────────────────
# Set LLM_PROVIDER to one of: anthropic, openai, google, groq, mistral, ollama
LLM_PROVIDER=anthropic
# Optional: override the default model for your chosen provider
# LLM_MODEL=claude-3-5-sonnet-20241022

# Anthropic (default)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Google Gemini
# GOOGLE_API_KEY=your-google-api-key

# Groq (fast + free tier available)
# GROQ_API_KEY=your-groq-api-key

# Mistral
# MISTRAL_API_KEY=your-mistral-api-key

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bughunter
REDIS_URL=redis://localhost:6379

# ── Storage (for screenshots) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
S3_BUCKET=bughunter-screenshots
S3_REGION=us-east-1
